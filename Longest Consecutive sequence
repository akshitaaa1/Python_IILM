class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:
        s = set(nums)
        res = 0
        for num in s: 
            if (num - 1) not in s:
                c = 1
                curr = num
                while (curr + 1) in s:
                    curr += 1
                    c += 1
                
                res = max(res, c)
                
        return res
